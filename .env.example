# Copy this file to ".env" and change the values. NEVER commit ".env".

# --- Audit database -------------------------------------------------------------
# Local default: a SQLite file (nothing to install).
DATABASE_URL=sqlite:///./audit.db
# PostgreSQL instead (run `docker compose up -d db` first, same password as below):
# DATABASE_URL=postgresql+psycopg2://soc:change-me-db-password@localhost:5432/soc_audit
# Used by docker-compose.yml for the postgres container and the api container.
POSTGRES_PASSWORD=change-me-db-password

# --- Open Policy Agent ----------------------------------------------------------
# Where OPA answers. In docker compose the api container uses http://opa:8181/... automatically.
OPA_URL=http://localhost:8181/v1/data/authz/allow

# --- Admin ----------------------------------------------------------------------
# Secret for the admin endpoints (header x-admin-key). Use a long random string.
# If this is empty, ALL admin endpoints refuse every request (fail closed).
ADMIN_KEY=change-me-to-a-long-random-string

# --- Security mode ----------------------------------------------------------------
# full         = the real system (default, the only safe value)
# header_only  = WEAK baseline: trusts the x-agent-role header (evaluation only)
# none         = NO checks at all (evaluation only)
SECURITY_MODE=full

# --- Misc ---------------------------------------------------------------------
# Browser origin allowed to call the API (the React dashboard).
CORS_ORIGIN=http://localhost:5173
# Address the DEV-ONLY simulator uses to call this same API.
SELF_URL=http://127.0.0.1:8000
# Optional: custom paths for key files (Docker sets these to /app/data/...).
# SERVER_KEY_PATH=
# ISSUER_KEY_PATH=
# REGISTRY_PATH=
# AGENTS_DIR=
